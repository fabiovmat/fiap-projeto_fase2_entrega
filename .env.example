# Copie para .env e ajuste antes de executar
GCP_PROJECT_ID=seu-projeto-gcp
BQ_LOCATION=US
GCS_BUCKET=seu-projeto-gcp-fiap-alfabetizacao
PUBSUB_TOPIC=alfabetizacao-eventos
PUBSUB_SUBSCRIPTION=alfabetizacao-consumer
# Máximo de bytes faturáveis por consulta BigQuery: 1 GiB. Aumente somente após dry-run.
MAX_BYTES_BILLED=1073741824
# URL de webhook configurável (Google Chat, Discord ou outro). Nunca versionar o token real.
ALERT_WEBHOOK_URL=
# Taxa mínima de correspondência exigida nos joins (0 a 1)
MIN_JOIN_MATCH_RATE=0.80
